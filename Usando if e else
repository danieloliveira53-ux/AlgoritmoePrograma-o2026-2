import java.util.Scanner;

public class Maiordeidade {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int idade = sc.nextInt();
         if(idade >= 18) {
            System.out.println("Adulto");
        } else { if(idade < 18);
            System.out.println("Menor");
        }
    }
}
